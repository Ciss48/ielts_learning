# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.

# --- Supabase (Phase 0) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (used from Phase 3: ingestion/vision, and Phase 5: feedback) ---
# The endpoint is OpenAI-compatible, so the provider is swappable. Groq is the
# default and the known-good one; any OpenAI-compatible gateway works by
# pointing AI_BASE_URL at it. AI_BASE_URL and AI_MODEL are optional — omitting
# them uses the Groq defaults in src/lib/config.ts.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=qwen/qwen3.6-27b

# --- Cloudflare R2 (used from Phase 3 for private test audio) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ielts-daily
